  `result` char(1) NOT NULL DEFAULT 's' COMMENT '결과: s=성공, f=실패(검증실패), r=거부(24시간제한)'
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='업소록 QR 코드 사용(스캔) 기록';

