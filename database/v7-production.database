--
-- 테이블 구조 `sf_member`
--

CREATE TABLE `sf_member` (
  `idx` int(10) UNSIGNED NOT NULL,
  `stamp` int(10) UNSIGNED NOT NULL DEFAULT 0,
  `id` varchar(64) NOT NULL DEFAULT '',
  `firebase_uid` varchar(64) DEFAULT NULL,
  `login_provider` varchar(32) DEFAULT NULL COMMENT 'v7 전용: 소셜 로그인 제공자 (google, apple, kakaotalk, naver, phone_sign_in)',
  `phone_number` varchar(24) DEFAULT NULL,
  `point` int(11) NOT NULL DEFAULT 0,
  `level` smallint(5) UNSIGNED NOT NULL DEFAULT 0,
  `webbrowser_id` varchar(32) NOT NULL DEFAULT '',
  `domain` varchar(32) NOT NULL DEFAULT '',
  `password` varchar(64) NOT NULL DEFAULT '',
  `language` char(2) NOT NULL DEFAULT '' COMMENT 'User Language Code',
  `name` varchar(64) NOT NULL DEFAULT '',
  `nickname` varchar(64) NOT NULL DEFAULT '',
  `email` varchar(64) NOT NULL DEFAULT '',
  `address` varchar(255) NOT NULL DEFAULT '',
  `landline` varchar(255) NOT NULL DEFAULT '',
  `mobile` varchar(255) NOT NULL DEFAULT '',
  `gender` char(1) NOT NULL DEFAULT '',
  `photo_url` varchar(255) NOT NULL DEFAULT '',
  `birth_day` tinyint(3) UNSIGNED NOT NULL DEFAULT 0,
  `birth_month` tinyint(3) UNSIGNED NOT NULL DEFAULT 0,
  `birth_year` smallint(5) UNSIGNED NOT NULL DEFAULT 0,
  `country` varchar(16) NOT NULL DEFAULT '',
  `province` varchar(32) NOT NULL DEFAULT '',
  `city` varchar(32) NOT NULL DEFAULT '',
  `race` varchar(32) NOT NULL DEFAULT '',
  `height` smallint(6) NOT NULL DEFAULT 0,
  `weight` smallint(6) NOT NULL DEFAULT 0,
  `eye_color` varchar(32) NOT NULL DEFAULT '',
  `hair_color` varchar(32) NOT NULL DEFAULT '',
  `religion` varchar(32) NOT NULL DEFAULT '',
  `relationship` varchar(32) NOT NULL DEFAULT '',
  `children` varchar(32) NOT NULL DEFAULT '',
  `smoking` char(1) NOT NULL DEFAULT '',
  `drinking` char(1) NOT NULL DEFAULT '',
  `look_for` char(1) NOT NULL DEFAULT '',
  `last_login` int(10) UNSIGNED NOT NULL DEFAULT 0,
  `last_login_ip` varchar(15) NOT NULL DEFAULT '',
  `last_active` int(10) UNSIGNED NOT NULL DEFAULT 0,
  `login_count` int(10) UNSIGNED NOT NULL DEFAULT 0,
  `days_of_visit` smallint(5) UNSIGNED NOT NULL DEFAULT 0,
  `photo` int(10) UNSIGNED NOT NULL DEFAULT 0,
  `greeting` text DEFAULT NULL,
  `new_message` smallint(5) UNSIGNED NOT NULL DEFAULT 0,
  `no_of_post` mediumint(8) UNSIGNED NOT NULL DEFAULT 0,
  `no_of_thread` mediumint(8) UNSIGNED NOT NULL DEFAULT 0,
  `no_of_comment` mediumint(8) UNSIGNED NOT NULL DEFAULT 0,
  `no_of_comment_history` smallint(5) UNSIGNED NOT NULL DEFAULT 0,
  `namecard_company_name` varchar(255) NOT NULL DEFAULT '',
  `namecard_line` varchar(255) NOT NULL DEFAULT '',
  `namecard_address` varchar(255) NOT NULL DEFAULT '',
  `namecard_landline` varchar(255) NOT NULL DEFAULT '',
  `namecard_mobile` varchar(255) NOT NULL DEFAULT '',
  `namecard_homepage` varchar(255) NOT NULL DEFAULT '',
  `namecard_email` varchar(255) NOT NULL DEFAULT '',
  `namecard_title` varchar(255) NOT NULL DEFAULT '',
  `namecard_name` varchar(255) NOT NULL DEFAULT '',
  `signature` varchar(255) NOT NULL DEFAULT '',
  `int_1` int(11) NOT NULL DEFAULT 0,
  `int_2` int(11) NOT NULL DEFAULT 0,
  `int_3` int(11) NOT NULL DEFAULT 0,
  `int_4` int(11) NOT NULL DEFAULT 0,
  `int_5` int(11) NOT NULL DEFAULT 0,
  `int_6` int(11) NOT NULL DEFAULT 0,
  `int_7` int(11) NOT NULL DEFAULT 0,
  `int_8` int(11) NOT NULL DEFAULT 0,
  `int_9` int(11) NOT NULL DEFAULT 0,
  `int_10` int(11) NOT NULL DEFAULT 0,
  `char_1` char(1) NOT NULL DEFAULT '',
  `char_2` char(1) NOT NULL DEFAULT '',
  `char_3` char(1) NOT NULL DEFAULT '',
  `char_4` char(1) NOT NULL DEFAULT '',
  `char_5` char(1) NOT NULL DEFAULT '',
  `char_6` char(1) NOT NULL DEFAULT '',
  `char_7` char(1) NOT NULL DEFAULT '',
  `char_8` char(1) DEFAULT '',
  `char_9` char(1) NOT NULL DEFAULT '',
  `char_10` char(1) NOT NULL DEFAULT '',
  `varchar_1` varchar(255) NOT NULL DEFAULT '',
  `varchar_2` varchar(255) NOT NULL DEFAULT '',
  `varchar_3` varchar(255) NOT NULL DEFAULT '',
  `varchar_4` varchar(255) NOT NULL DEFAULT '',
  `varchar_5` varchar(255) NOT NULL DEFAULT '',
  `varchar_6` varchar(255) NOT NULL DEFAULT '',
  `varchar_7` varchar(255) NOT NULL DEFAULT '',
  `varchar_8` varchar(255) NOT NULL DEFAULT '',
  `varchar_9` varchar(255) NOT NULL DEFAULT '',
  `varchar_10` varchar(255) NOT NULL DEFAULT '',
  `text_1` longtext DEFAULT NULL,
  `text_2` longtext DEFAULT NULL,
  `text_3` longtext DEFAULT NULL,
  `text_4` longtext DEFAULT NULL,
  `text_5` longtext DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_uca1400_ai_ci;

