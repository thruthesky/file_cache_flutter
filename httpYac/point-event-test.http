# ============================================================
# v7 PointEvent API — httpYac 테스트
# ============================================================
#
# 사용법:
#   1. VS Code에서 "httpYac" 확장 설치 (anweber.vscode-httpyac)
#   2. 아래 @session_id 값을 실제 세션 ID로 변경
#   3. 각 요청 옆의 ▶ (Send) 클릭
#
# 테스트 계정 (v7-accounts.md 참조):
#   - Durian 계정: session_id = 2278018daa75e0ab879d8791fb0e2b2d-190076
#   - Poster 계정: session_id = d87e7374e22f1bf1aaebbbb97d280115-193824
#
# ⚠️ 중요 사항:
#   - files 파라미터에는 업로드된 URL을 사용해야 합니다.
#   - 먼저 upload.upload API로 파일을 업로드하고, 반환된 URL을 사용하세요.
#   - receipt_date는 필리핀 시간(PHT, UTC+8) 기준입니다.
#   - files 구분자는 쉼표(,)입니다.
#
# 참고 문서: references/api/v7-point-event.md
# ============================================================

# === 파일 글로벌 변수 (첫 ### 이전 = Global Region) ===
@baseUrl = https://local.philgo.com/api.php
# Durian 테스트 계정 (sf_member.idx: 190076)
@session_id = 2278018daa75e0ab879d8791fb0e2b2d-190076

# 업로드된 파일 URL (사전에 upload.upload API로 업로드 필요)
# 아래는 예시 URL입니다. 실제 테스트 시 업로드 후 반환된 URL로 교체하세요.
@food_photo_1 = /uploads/190076/69a19632f23df_1772197426.webp
@food_photo_2 = /uploads/190076/69a1963a494c5_1772197434.webp
@receipt_photo = /uploads/190076/69a1963bba302_1772197435.webp
# 실제 영수증 이미지 (receipt-nans.jpeg 업로드 후 반환된 URL로 교체)
@receipt_photo_nans = /uploads/190076/69a1bbc73a10a_1772207047.webp


### ============================================================
### 0. 파일 업로드 (사전 단계 — 음식 사진)
### ============================================================
# 먹방 이벤트 글 생성 전, 음식 사진을 먼저 업로드합니다.
# 응답의 url 값을 상단의 @food_photo_1 변수에 설정하세요.
# @name uploadFood
# @no-reject-unauthorized
POST {{baseUrl}}?method=upload.upload&session_id={{session_id}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="file"; filename="사과.jpg"
Content-Type: image/jpeg

< ./tmp/sample-files/사과.jpg
------WebKitFormBoundary--

?? status == 200

{{
  const body = response.parsedBody;
  console.info("[uploadFood] 상태: " + response.statusCode);
  if (body.url) {
    console.info("[uploadFood] 업로드 URL: " + body.url);
    console.info("▶ 이 URL을 @food_photo_1 변수에 설정하세요");
    exports.uploadedFoodUrl = body.url;
  }
}}

### ============================================================
### 0-1. 실제 영수증 이미지 업로드 (receipt-nans.jpeg)
### ============================================================
# 실제 영수증 이미지(receipt-nans.jpeg)를 업로드합니다.
# 응답의 url 값을 상단의 @receipt_photo_nans 변수에 설정하세요.
# @name uploadReceipt
# @no-reject-unauthorized
POST {{baseUrl}}?method=upload.upload&session_id={{session_id}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="file"; filename="receipt-nans.jpeg"
Content-Type: image/jpeg

< ./tmp/sample-files/receipt-nans.jpeg
------WebKitFormBoundary--

?? status == 200

{{
  const body = response.parsedBody;
  console.info("[uploadReceipt] 상태: " + response.statusCode);
  if (body.url) {
    console.info("[uploadReceipt] 영수증 URL: " + body.url);
    console.info("▶ 이 URL을 @receipt_photo_nans 변수에 설정하세요");
    exports.uploadedReceiptUrl = body.url;
  }
}}

### ============================================================
### 1. 주간 이벤트 횟수 조회
### ============================================================
# 현재 로그인 사용자의 이번 주 먹방 이벤트 참여 횟수를 확인합니다.
# 응답: { count, remaining, limit, member_point, events[] }
# @name weeklyCount
# @no-reject-unauthorized
GET {{baseUrl}}?method=pointEvent.weeklyCount&session_id={{session_id}}&dummy={{$timestamp}}

?? status == 200
?? body success == true
?? body data.count isNumber
?? body data.remaining isNumber
?? body data.limit isNumber

{{
  const body = response.parsedBody;
  console.info("[weeklyCount] 상태: " + response.statusCode);
  if (body.success) {
    console.info("[weeklyCount] 이번 주 참여: " + body.data.count + "회");
    console.info("[weeklyCount] 남은 횟수: " + body.data.remaining + "회");
    console.info("[weeklyCount] 주간 제한: " + body.data.limit + "회");
    console.info("[weeklyCount] 보유 포인트: " + body.data.member_point);
  }
}}

### ============================================================
### 2. 먹방 이벤트 글 생성 — AI 영수증 검증 (receipt_url 제공)
### ============================================================
# receipt_url 제공 시 AiService::analyzeReceiptByUrl()로 AI 검증.
# AI 분석 성공 → is_receipt, is_authentic, date(24시간) 검증.
# AI 분석 실패 → receipt_date 폴백.
# 응답에 receipt 필드 포함 (AI 분석 결과).
#
# ⚠️ files와 receipt_url은 업로드된 URL을 사용하세요.
# @name createMukbangAI
# @no-reject-unauthorized
GET {{baseUrl}}?method=pointEvent.createMukbang&session_id={{session_id}}&subject=맛있는 삼겹살 후기&content=정말 맛있었어요! 강추합니다.&files={{food_photo_1}},{{food_photo_2}}&receipt_url={{receipt_photo_nans}}&receipt_date={{$datetime iso8601}}

?? status == 200
?? body success == true

{{
  const body = response.parsedBody;
  console.info("[createMukbangAI] 상태: " + response.statusCode);
  if (body.success) {
    console.info("[createMukbangAI] 글 IDX: " + body.data.idx);
    console.info("[createMukbangAI] 포인트 지급: " + JSON.stringify(body.data.event_point));
    if (body.data.receipt) {
      console.info("[createMukbangAI] AI 영수증 분석: " + JSON.stringify(body.data.receipt));
    }
  } else {
    console.warn("[createMukbangAI] 실패: " + body.message);
  }
}}

### ============================================================
### 3. 먹방 이벤트 글 생성 — 영수증 날짜 직접 지정 (PHT 시각)
### ============================================================
# receipt_date를 필리핀 현지 시간(PHT, UTC+8)으로 직접 입력합니다.
# 서버가 자동으로 PHT → UTC 변환 처리합니다.
# @name createMukbangManualDate
# @no-reject-unauthorized
GET {{baseUrl}}?method=pointEvent.createMukbang&session_id={{session_id}}&subject=점심 먹방 후기&content=오늘 점심 정말 맛있었습니다&files={{food_photo_1}}&receipt_url={{receipt_photo_nans}}&receipt_date=2026-02-27 23:30:00

?? status == 200
?? body success == true

{{
  const body = response.parsedBody;
  console.info("[createMukbangManualDate] 상태: " + response.statusCode);
  if (body.success) {
    console.info("[createMukbangManualDate] 포인트 지급 여부: " + body.data.event_point?.awarded);
  }
}}

### ============================================================
### 4. 먹방 이벤트 글 생성 — 영수증 만료 (24시간 초과)
### ============================================================
# 영수증 날짜가 24시간 이전이면 글은 생성되지만 포인트는 미지급.
# 응답의 event_point.awarded = false, reason = "영수증이 24시간이 지났습니다."
# @name createMukbangExpired
# @no-reject-unauthorized
GET {{baseUrl}}?method=pointEvent.createMukbang&session_id={{session_id}}&subject=어제 먹은 갈비&content=어제 먹은 갈비인데 올려봅니다&files={{food_photo_1}}&receipt_url={{receipt_photo_nans}}&receipt_date=2025-01-01 12:00:00

?? status == 200
?? body success == true
?? body data.event_point.awarded == false

{{
  const body = response.parsedBody;
  console.info("[createMukbangExpired] 상태: " + response.statusCode);
  if (body.success) {
    console.info("[createMukbangExpired] 포인트 지급: " + body.data.event_point?.awarded);
    console.info("[createMukbangExpired] 사유: " + body.data.event_point?.reason);
  }
}}

### ============================================================
### 5. 먹방 이벤트 글 생성 — 영수증 정보 누락
### ============================================================
# receipt_url과 receipt_date 모두 없으면 포인트 미지급.
# 응답의 event_point.awarded = false, reason = "영수증 정보가 부족합니다."
# @name createMukbangNoReceipt
# @no-reject-unauthorized
GET {{baseUrl}}?method=pointEvent.createMukbang&session_id={{session_id}}&subject=영수증 없는 후기&content=영수증은 없지만 맛있었어요&files={{food_photo_1}}

?? status == 200
?? body success == true
?? body data.event_point.awarded == false

{{
  const body = response.parsedBody;
  console.info("[createMukbangNoReceipt] 상태: " + response.statusCode);
  if (body.success) {
    console.info("[createMukbangNoReceipt] 포인트 지급: " + body.data.event_point?.awarded);
    console.info("[createMukbangNoReceipt] 사유: " + body.data.event_point?.reason);
  }
}}

### ============================================================
### 6. 먹방 이벤트 글 생성 — 미래 날짜 영수증 (5분 초과)
### ============================================================
# 영수증 날짜가 현재보다 5분 이상 미래이면 포인트 미지급.
# 응답의 event_point.awarded = false, reason = "영수증 날짜가 유효하지 않습니다."
# @name createMukbangFuture
# @no-reject-unauthorized
GET {{baseUrl}}?method=pointEvent.createMukbang&session_id={{session_id}}&subject=미래 영수증 테스트&content=미래 날짜 영수증 테스트&files={{food_photo_1}}&receipt_url={{receipt_photo_nans}}&receipt_date=2027-12-31 23:59:59

?? status == 200
?? body success == true
?? body data.event_point.awarded == false

{{
  const body = response.parsedBody;
  console.info("[createMukbangFuture] 상태: " + response.statusCode);
  if (body.success) {
    console.info("[createMukbangFuture] 포인트 지급: " + body.data.event_point?.awarded);
    console.info("[createMukbangFuture] 사유: " + body.data.event_point?.reason);
  }
}}

### ============================================================
### 7. 먹방 이벤트 글 생성 — 미인증 (session_id 없음)
### ============================================================
# 로그인하지 않은 상태에서 호출하면 에러.
# 응답: { success: false, message: "로그인이 필요합니다." }
# @name createMukbangNoAuth
# @no-reject-unauthorized
GET {{baseUrl}}?method=pointEvent.createMukbang&subject=비로그인 테스트&content=테스트

?? status == 200
?? body success == false

{{
  const body = response.parsedBody;
  console.info("[createMukbangNoAuth] 상태: " + response.statusCode);
  console.info("[createMukbangNoAuth] 성공 여부: " + body.success);
  console.info("[createMukbangNoAuth] 에러 메시지: " + body.message);
}}

### ============================================================
### 8. 주간 횟수 조회 — 미인증
### ============================================================
# 로그인하지 않은 상태에서 호출하면 에러.
# @name weeklyCountNoAuth
# @no-reject-unauthorized
GET {{baseUrl}}?method=pointEvent.weeklyCount

?? status == 200
?? body success == false

{{
  const body = response.parsedBody;
  console.info("[weeklyCountNoAuth] 상태: " + response.statusCode);
  console.info("[weeklyCountNoAuth] 성공 여부: " + body.success);
  console.info("[weeklyCountNoAuth] 에러 메시지: " + body.message);
}}

### ============================================================
### 9. 먹방 이벤트 글 생성 — receipt_url만 제공 (receipt_date 없음)
### ============================================================
# receipt_url만 있고 receipt_date 없는 경우:
# - AI 분석 성공 → AI 결과로 검증
# - AI 분석 실패 → "영수증 정보가 부족합니다." (폴백 불가)
# 글은 항상 생성됨.
# @name createMukbangAIOnly
# @no-reject-unauthorized
GET {{baseUrl}}?method=pointEvent.createMukbang&session_id={{session_id}}&subject=AI만 검증 테스트&content=receipt_date 없이 receipt_url만 제공&files={{food_photo_1}}&receipt_url={{receipt_photo_nans}}

?? status == 200
?? body success == true

{{
  const body = response.parsedBody;
  console.info("[createMukbangAIOnly] 상태: " + response.statusCode);
  if (body.success) {
    console.info("[createMukbangAIOnly] 글 IDX: " + body.data.idx);
    console.info("[createMukbangAIOnly] 포인트 지급: " + body.data.event_point?.awarded);
    console.info("[createMukbangAIOnly] 사유: " + (body.data.event_point?.reason || "없음"));
  }
}}

### ============================================================
### 10. 업로드 후 먹방 이벤트 생성 (체이닝 테스트)
### ============================================================
# uploadFood → uploadReceipt → createMukbang 순서로 체이닝
# @forceRef로 항상 최신 업로드 URL 사용
# @name createMukbangChained
# @forceRef uploadFood
# @forceRef uploadReceipt
# @no-reject-unauthorized
GET {{baseUrl}}?method=pointEvent.createMukbang&session_id={{session_id}}&subject=체이닝 테스트 후기&content=업로드부터 글생성까지 자동 체이닝&files={{uploadedFoodUrl}}&receipt_url={{uploadedReceiptUrl}}&receipt_date={{$datetime iso8601}}

?? status == 200
?? body success == true

{{
  const body = response.parsedBody;
  console.info("[createMukbangChained] 상태: " + response.statusCode);
  if (body.success) {
    console.info("[createMukbangChained] 업로드→글생성 체이닝 성공!");
    console.info("[createMukbangChained] 글 IDX: " + body.data.idx);
    console.info("[createMukbangChained] 포인트 지급: " + JSON.stringify(body.data.event_point));
  }
}}
