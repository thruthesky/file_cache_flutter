###
# 8. 포인트 로그 수정 (pointLog.update)
# @name updateLog
# @ref changePoints
# @no-reject-unauthorized
POST {{baseUrl}}
Content-Type: application/json

{
  "method": "pointLog.update",
  "session_id": "{{session_id}}",
  "idx": {{lastLogIdx}},
  "etc": "httpYac 테스트 - 수정됨"
}

?? status == 200
?? body idx >= 1
?? body etc == httpYac 테스트 - 수정됨

{{
  const body = response.parsedBody;
  console.info("[updateLog] 상태: " + response.statusCode);
  if (body.idx) {
    console.info("[updateLog] 수정 완료: idx=" + body.idx + ", etc=" + body.etc);
  } else {
    console.warn("[updateLog] 실패: " + body.message);
  }
}}

###
# 9. 포인트 로그 삭제 (pointLog.delete)
# @name deleteLog
# @ref updateLog
# @no-reject-unauthorized
POST {{baseUrl}}
Content-Type: application/json

{
  "method": "pointLog.delete",
  "session_id": "{{session_id}}",
  "idx": {{lastLogIdx}}
}

?? status == 200
?? body deleted == true

{{
  const body = response.parsedBody;
  console.info("[deleteLog] 상태: " + response.statusCode);
  if (body.deleted) {
    console.info("[deleteLog] 삭제 완료: idx=" + body.idx);
  } else {
    console.warn("[deleteLog] 실패: " + body.message);
  }
}}

###
# 10. 미인증 상태에서 포인트 변경 시도 (에러 확인)
# 예상: {success: false, message: "로그인이 필요합니다."}
# @name changePointsNoAuth
# @no-reject-unauthorized
POST {{baseUrl}}
Content-Type: application/json

{
  "method": "pointLog.changePoints",
  "points": 100,
  "module": "test",
  "action": "unauthorized_test"
}

?? status == 200
?? body success == false
?? body message exists

{{
  const body = response.parsedBody;
  console.info("[changePointsNoAuth] 상태: " + response.statusCode);
  console.info("[changePointsNoAuth] 성공 여부: " + body.success);
  console.info("[changePointsNoAuth] 에러 메시지: " + body.message);
}}

###
# 11. 필수 파라미터 누락 테스트 (에러 확인)
# 예상: {success: false, message: "points 파라미터가 필요합니다."}
# @name changePointsMissingParam
# @no-reject-unauthorized
POST {{baseUrl}}
Content-Type: application/json

{
  "method": "pointLog.changePoints",
  "session_id": "{{session_id}}",
  "module": "test",
  "action": "missing_points_test"
}

?? status == 200
?? body success == false
?? body message exists

{{
  const body = response.parsedBody;
  console.info("[changePointsMissingParam] 에러 메시지: " + body.message);
}}
