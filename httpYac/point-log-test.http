# 포인트 로그 (sf_point_log) CRUD API 테스트 (httpYac)
# 참고: references/api/v7-point-log.md
#
# 응답 구조 (v7 규칙):
#   성공 시 → Controller 리턴 배열 그대로 (success 키 없음)
#   에러 시 → {success: false, message: "..."}
#
# 주의: httpYac의 exists assertion은 truthy 체크이므로 값이 0이면 실패한다.
#       0이 될 수 있는 숫자 필드는 >= 비교를 사용해야 한다.

@baseUrl = https://local.philgo.com/api.php
@session_id = 8d70afcb6c88ecb95bc78d2d58f7f5d3-188690

###
# 1. 회원 현재 포인트 조회 (pointLog.memberPoint)
# @name memberPoint
# @no-reject-unauthorized
POST {{baseUrl}}
Content-Type: application/json

{
  "method": "pointLog.memberPoint",
  "session_id": "{{session_id}}"
}

?? status == 200
?? body idx_member >= 1
?? body point >= 0

{{
  const body = response.parsedBody;
  console.info("[memberPoint] 상태: " + response.statusCode);
  if (body.idx_member) {
    console.info("[memberPoint] 회원 번호: " + body.idx_member);
    console.info("[memberPoint] 현재 포인트: " + body.point);
    $global.memberIdx = body.idx_member;
    $global.pointBefore = body.point;
  } else {
    console.warn("[memberPoint] 실패: " + body.message);
  }
}}

###
# 2. 포인트 변경 - 100P 증가 (pointLog.changePoints)
# @name changePoints
# @ref memberPoint
# @no-reject-unauthorized
POST {{baseUrl}}
Content-Type: application/json

{
  "method": "pointLog.changePoints",
  "session_id": "{{session_id}}",
  "points": 100,
  "module": "test",
  "action": "httpyac_test",
  "etc": "httpYac 테스트 포인트 충전"
}

?? status == 200
?? body idx >= 1
?? body point == 100
?? body module == test
?? body action == httpyac_test
?? body point_after >= 0

{{
  const body = response.parsedBody;
  console.info("[changePoints] 상태: " + response.statusCode);
  if (body.idx) {
    console.info("[changePoints] 로그 idx: " + body.idx);
    console.info("[changePoints] 변경 전: " + body.point_before + "P");
    console.info("[changePoints] 변경량: " + body.point + "P");
    console.info("[changePoints] 변경 후: " + body.point_after + "P");
    console.info("[changePoints] 모듈: " + body.module);
    console.info("[changePoints] 액션: " + body.action);
    console.info("[changePoints] 사유: " + body.etc);
    $global.lastLogIdx = body.idx;
  } else {
    console.warn("[changePoints] 실패: " + body.message);
  }
}}

###
# 3. 포인트 로그 단건 조회 (pointLog.get)
# @name getLog
# @ref changePoints
# @no-reject-unauthorized
POST {{baseUrl}}
Content-Type: application/json

{
  "method": "pointLog.get",
  "session_id": "{{session_id}}",
  "idx": {{lastLogIdx}}
}

?? status == 200
?? body idx >= 1
?? body module == test
?? body action == httpyac_test
?? body created_at isString

{{
  const body = response.parsedBody;
  console.info("[getLog] 상태: " + response.statusCode);
  if (body.idx) {
    console.info("[getLog] 로그 idx: " + body.idx);
    console.info("[getLog] 생성일: " + body.created_at);
    console.info("[getLog] 모듈/액션: " + body.module + "/" + body.action);
  } else {
    console.warn("[getLog] 실패: " + body.message);
  }
}}

###
# 4. 포인트 히스토리 조회 (pointLog.history)
# @name history
# @no-reject-unauthorized
POST {{baseUrl}}
Content-Type: application/json

{
  "method": "pointLog.history",
  "session_id": "{{session_id}}",
  "page": 1,
  "limit": 10
}

?? status == 200
?? body total >= 0
?? body page >= 1
?? body limit >= 1
?? body items isArray

{{
  const body = response.parsedBody;
  console.info("[history] 상태: " + response.statusCode);
  if (body.items) {
    console.info("[history] 총 로그 수: " + body.total);
    console.info("[history] 현재 페이지: " + body.page);
    console.info("[history] 현재 페이지 항목 수: " + body.items.length);
    if (body.items.length > 0) {
      const item = body.items[0];
      console.info("[history] 최신 로그: idx=" + item.idx
        + ", module=" + item.module
        + ", action=" + item.action
        + ", point=" + item.point
        + ", point_after=" + item.point_after);
    }
  }
}}

###
# 5. 모듈 필터로 히스토리 조회 (pointLog.history + module 필터)
# @name historyFiltered
# @no-reject-unauthorized
POST {{baseUrl}}
Content-Type: application/json

{
  "method": "pointLog.history",
  "session_id": "{{session_id}}",
  "page": 1,
  "limit": 5,
  "module": "test"
}

?? status == 200
?? body total >= 0
?? body items isArray

{{
  const body = response.parsedBody;
  console.info("[historyFiltered] module=test 필터 결과: " + body.total + "건");
}}

